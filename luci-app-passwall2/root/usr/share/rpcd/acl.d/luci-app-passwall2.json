					"update_rules",
					"rollback_rules",
					"add_shunt_rule",
					"delete_select_shunt_rules",
					"flush_set",
					"subscribe_del_node",
					"subscribe_del_all",
					"subscribe_manual",
					"subscribe_manual_all",
					"com_update",
					"restore_backup",
					"reset_config",
					"show",
					"hide",
					"show_menu",
					"hide_menu",
					"set_auto_lang",
					"reorder_sections",
					"update_passwall2",
					"update_geoview",
					"update_xray",
					"update_sing-box"
				],
				"file": [
					"write"
				],
				"uci": [
					"add",
					"apply",
					"confirm",
					"delete",
					"order",
					"rename",
					"revert",
					"set"
				]
