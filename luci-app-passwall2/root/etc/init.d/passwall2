#!/bin/sh /etc/rc.common
# passwall2-rs service wrapper. Same semantics as upstream luci-app-passwall2; all
# application logic lives in the Rust binary /usr/bin/passwall2, which also implements
# upstream's locking of this script:
#   start   : /var/lock/passwall2.lock non-blocking, "The script is already running,
#             do not run it again. Exit." (returns 0)
#   stop    : same lock, blocking ("Unable to acquire the stop lock. Exiting.", returns 1)
#   restart : lock non-blocking (returns 1 for "boot", else 0), then waits up to 600 s for
#             subscription/rule updates (/var/lock/passwall2_sub_rule.lock), then stop + start
# The lock is held by the binary itself (not on fd 9 of this shell), so core processes it
# launches never inherit it.

START=99
STOP=15

CONFIG=passwall2
APP_BIN=${IPKG_INSTROOT}/usr/bin/passwall2
LOCK_PATH=/var/lock
LOG_FILE=/tmp/log/${CONFIG}.log

# log_i18n 0 FMT [ARGS...] (level-0 log line, same format as the backend)
log_i18n() {
	shift
	local fmt="$1"
	shift
	mkdir -p "${LOG_FILE%/*}"
	echo "$(date "+%Y-%m-%d %H:%M:%S"): $(printf "$fmt" "$@")" >>"$LOG_FILE"
}

boot_func() {
	rm -f ${LOCK_PATH}/${CONFIG}_ready.lock
	local delay=$(uci -q get ${CONFIG}.@global_delay[0].start_delay || echo 1)
	if [ "$delay" -gt 0 ]; then
		log_i18n 0 "Start after a delay of %s seconds!" "${delay}"
		sleep $delay
	fi
	restart boot || return 1
	touch ${LOCK_PATH}/${CONFIG}_ready.lock
}

boot() {
	boot_func >/dev/null 2>&1 &
}

start() {
	local action=${2:-$1}
	[ "$action" = "start" ] && action=
	"$APP_BIN" start ${action:+"$action"}
}

stop() {
	local action=${2:-$1}
	[ "$action" = "stop" ] && action=
	# package removal/upgrade may have dropped the binary already (nothing of ours can run then)
	[ -x "$APP_BIN" ] || return 0
	"$APP_BIN" stop ${action:+"$action"}
}

restart() {
	local action=${2:-$1}
	[ "$action" = "restart" ] && action=
	"$APP_BIN" restart ${action:+"$action"}
}

reload() {
	echo "Warning: This service does not support configuration reloading"
	echo "Performing full restart instead..."
	restart
}
