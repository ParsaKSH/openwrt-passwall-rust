{
	"luci-app-passwall2": {
		"description": "Grant UCI and RPC access for luci-app-passwall2 (read: status/log/query methods; write: methods that change config, files or services)",
		"read": {
			"ubus": {
				"luci.passwall2": [
					"index_status",
					"haproxy_status",
					"socks_status",
					"connect_status",
					"ping_node",
					"urltest_node",
					"get_now_use_node",
					"get_redir_log",
					"get_socks_log",
					"get_log",
					"server_status",
					"server_log",
					"server_get_log",
					"gen_client_config",
					"get_node",
					"gen_node_json",
					"get_shunt_rules",
					"geo_view",
					"com_check",
					"com_version",
					"create_backup",
					"fetch_certsha256",
					"gen_wireguard_key",
					"job_status",
					"get_env",
					"get_valid_nodes",
					"get_node_list",
					"rule_status",
					"get_singbox_tags",
					"check_passwall2",
					"check_geoview",
					"version_geoview",
					"check_xray",
					"version_xray",
					"check_sing-box",
					"version_sing-box"
				],
				"file": [
					"read",
					"stat",
					"list"
				],
				"luci": [
					"getInitList",
					"getFeatures"
				],
				"luci-rpc": [
					"getHostHints",
					"getNetworkDevices",
					"getBoardJSON",
					"getWirelessDevices",
					"getDHCPLeases"
				],
				"network.interface": [
					"dump"
				],
				"uci": [
					"get",
					"state",
					"changes"
				]
			},
			"file": {
				"/proc/modules": [
					"read"
				],
				"/tmp/etc/passwall2/var": [
					"read"
				],
				"/tmp/etc/passwall2/*": [
					"list",
					"read"
				],
				"/tmp/etc/passwall2_server/*": [
					"list",
					"read"
				],
				"/tmp/log/passwall2.log": [
					"read"
				],
				"/tmp/log/passwall2_server.log": [
					"read"
				],
				"/tmp/bak_v2ray/*": [
					"list",
					"read"
				],
				"/usr/share/passwall2/direct_ip": [
					"read"
				],
				"/usr/share/passwall2/domains_excluded": [
					"read"
				],
				"/usr/share/v2ray/*": [
					"list",
					"read"
				],
				"/tmp/etc/passwall2/acl/*": [
					"list",
					"read"
				]
			},
			"uci": [
				"passwall2",
				"passwall2_server",
				"network",
				"dhcp",
				"firewall",
				"wireless",
				"luci"
			]
		},
		"write": {
			"ubus": {
				"luci.passwall2": [
					"clear_log",
					"server_update_config",
					"server_clear_log",
